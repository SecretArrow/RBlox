; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="RBlox"
config/description="Sandbox 3D gratis bergaya blocky: bangun, main, dan berbagi dunia. Offline & multiplayer lokal. 100% gratis tanpa iklan."
config/version="0.3.0"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.4", "Mobile")
boot_splash/bg_color=Color(0.07, 0.08, 0.12, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

Locale="*res://scripts/autoload/locale_manager.gd"
Settings="*res://scripts/autoload/settings_manager.gd"
GameState="*res://scripts/autoload/game_state.gd"
Saves="*res://scripts/autoload/save_manager.gd"
Net="*res://scripts/autoload/net_manager.gd"
PolyBudget="*res://scripts/autoload/poly_budget.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[physics]

3d/default_gravity=12.0

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
; Perangkat/emulator tanpa Vulkan otomatis fallback ke OpenGL (Compatibility)
rendering_device/fallback_to_opengl3=true
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
textures/default_filters/anisotropic_filtering_level=4
lights_and_shadows/directional_shadow/size=2048
